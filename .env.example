# 토스증권 WTS > 설정 > Open API 에서 발급 (허용 IP 등록 필수)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# python toss.py 실행해 나온 accountSeq 값
TOSS_ACCOUNT_SEQ=

# Claude API 키 (console.anthropic.com). OmniRoute 경유 시엔 아무 값이나(로컬) 또는 OmniRoute 토큰
ANTHROPIC_API_KEY=
# 선택: OmniRoute 같은 게이트웨이 경유. 설정하면 베타 기능(대체 모델·JSON 스키마 강제) 없이 호출
# ANTHROPIC_BASE_URL=http://localhost:20128
# CLAUDE_MODEL=claude/claude-sonnet-5   # OmniRoute 의 모델 ID (공급자 접두어 포함)

# 1 이면 주문 없이 전 과정을 기록만. 실주문은 0
DRY_RUN=1
# 실행 시각 (KST, 콤마 구분): 개장 22:30 → 23:30 → 00:00 부터 2시간 간격. 정규장 밖 시각은 자동 건너뜀
TRADE_TIMES=17:00,22:30,23:30,00:00,02:00,04:00,06:00,08:00
# 사전 분석(주문 없이 스크리닝·판단만) 시각. 서머타임 양쪽을 걸어두면
# 정규장 개장 60분 전 창에 드는 쪽만 실행된다. 빈 값이면 끔
ANALYSIS_TIMES=22:00,23:00
# 프리장·애프터장 주문 여부 (0 이면 정규장만)
PREMARKET=1
AFTERMARKET=1

# --- 깔때기 · 리스크 규칙 (1998~2026 백테스트 기준. 근거는 backtest_slots.py) ---
SCREEN_N=40           # 상위 몇 종목을 Claude 후보 선별에 보여줄지
TOP_N=10              # Claude 가 고르는 후보 수
MAX_POSITIONS=10      # 동시 보유 최대 종목 수
                      #   5 → 10 으로 늘리면 최대낙폭이 양 구간 모두 개선되고(-67.5%→-61.2%,
                      #   -40.8%→-36.7%) 단일 종목 최대 노출이 38.8%→20.9% 로 준다.
                      #   대가는 검증 구간 CAGR -8.6%p. 수익 우선이면 5 도 방어 가능한 선택이다.
MAX_POSITION_PCT=15   # 종목당 최대 비중 (총자산 대비 %). 슬롯 10 에 맞춰 30 → 15
                      #   매수 시점에만 걸린다. 이미 한도를 넘은 보유분을 강제로 팔지는 않는다
                      #   (비중 트림은 성적에 차이가 없었다 — backtest_slots.py)
CASH_RESERVE_PCT=10   # 항상 남겨둘 현금 비중 (%)
MIN_ORDER_USD=5
STOP_LOSS_PCT=0       # 평단 대비 -N% 면 Claude 판단과 무관하게 전량 매도. 기본 0(끔) — -10~-30% 전 구간에서 성적 악화
MOMENTUM_EXIT=0       # 20일 수익률 음전 시 전량 매도. 만기 청산(MAX_HOLD_DAYS)이 우위라 기본 꺼짐
WORKERS=3             # 종목별 판단 병렬 수

# --- 국면 인식 · 만기 청산 ---
HOLD_EXTEND_TOP=0     # 만기 도달 종목이 그 시점 선별 상위 N위 안이면 팔지 않고 다음 사이클에
                      #   다시 판정한다. 만기를 '매도 시점'이 아니라 '재심 시점'으로 바꾼다.
                      #   판정 기준은 screen() 의 정렬이라 국면에 따라 질문이 바뀐다 —
                      #   평상시 "지금도 20일 모멘텀 상위인가", 하락 국면 "지금도 저변동성 상위인가".
                      #   0 이면 끔(현행). PIT 2015~2026 에서 20 이면 MDD -29.5%→-24.3%,
                      #   Sharpe 0.450→0.650, 회전율 10.8→9.6 이지만 **사전등록 채택 기준
                      #   (DSR>=0.95)을 통과하지 못했고 편향구간 부호가 반대**다. 섀도 먼저.
                      #   MAX_HOLD_DAYS=40 과 같이 쓰면 성적이 나빠진다 — 둘 중 하나만.
                      #   근거: research/exit_condition.md
MAX_HOLD_DAYS=20      # 보유 N 거래일이 지나면 코드가 강제 청산. 0 이면 끔
                      #   고정 20거래일 청산의 승률은 56.4% 로, 구 규칙("20일 수익률 음전 시
                      #   매도", 42.1%)보다 14%p 높고 하락 5구간 전부에서 1등이었다
BEAR_INDEX=QQQ        # 국면 판정용 지수 ETF. 빈 값이면 유니버스 60일 수익률 중앙값으로 대체
VOL_TARGET_PCT=30     # 계좌 실현 변동성(연율 %)이 이 값을 넘으면 주식 노출을 줄인다. 0 이면 끔
                      #   타겟 25~35% 가 양 구간 모두 Sharpe·최대낙폭 개선 (타겟 30%:
                      #   Sharpe 1.45→1.48 / 1.32→1.34, MDD -48.2%→-45.1% / -36.9%→-31.2%)
                      #   신규 매수만 조이는 방식은 효과가 0 이었다 — 보유분을 줄여야 작동한다
VOL_WINDOW=60         # 실현 변동성 계산 창 (거래일). 40~120 모두 비슷하게 작동
                      #   ※ 이 창만큼 일별 자산 이력이 쌓여야 기능이 켜진다 (그전엔 자동 비활성)
BEAR_RET60_PCT=-3     # 지수 60일 수익률이 이 값 밑이면 하락 국면 →
                      #   선별 기준이 20일 모멘텀에서 저변동성(atr_pct)으로 바뀐다.
                      #   하락장 진입 승률 50.2%→58.4%(탐색) / 61.6%→68.8%(검증)

# 선택: 뉴스 수집 (serpapi.com). 없으면 뉴스 없이 판단
SERPAPI_API_KEY=

# --- A1 기계 모드 (Claude 호출 없음) ---
STRATEGY=soxl         # 기본값 soxl · llm(기존 3단계 LLM 전략) | a1(시총 상위 N 회사 시총 비중) | soxl(SOXL 40% 리밸런싱 — 메인 규칙)
A1_TOP=10             # 보유 회사 수. 탐색상 5와 10은 구분 안 됨 (research/mcap_momentum.md)
A1_REBAL_DAYS=20      # 재조정 주기(거래일). 목표에 수렴한 시점부터 센다. 60도 성적 차이 없음
A1_CASH_PCT=1         # 수수료·반올림 여유 현금 %
A1_BAND_PCT=2         # 목표와 총자산의 이 % 이내 차이면 거래하지 않음
# ★ a1 에서는 MAX_HOLD_DAYS·VOL_TARGET_PCT·MAX_POSITION_PCT·RESERVE_RESTORE 를 쓰지 않는다

# --- SOXL 메인 규칙 (STRATEGY=soxl, Claude 호출 없음) — research/soxl_ops.md ---
# 목표 40% · 30% 미만 매수 / 50% 초과 매도 · 매수 후 비중 ≤ 70% · SOXL 252일 고점 대비 −30% 이하면 매수 중단 ·
# 포지션 63거래일에 50% 축소(1회) · SOXL 밖 보유는 전량 정리. 규칙 수치는 백테스트 동등성 때문에 코드 상수다.
SOXL_SYMBOL=SOXL
# ★ 해외 레버리지 ETF 는 기본예탁금·사전교육 요건이 있다. 미충족 계좌에서는 SOXL 매수가 거절된다.
