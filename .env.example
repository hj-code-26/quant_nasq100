# 토스증권 WTS > 설정 > Open API 에서 발급 (허용 IP 등록 필수)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# python toss.py 실행해 나온 accountSeq 값
TOSS_ACCOUNT_SEQ=

# Claude API 키 (console.anthropic.com). OmniRoute 경유 시엔 아무 값이나(로컬) 또는 OmniRoute 토큰
ANTHROPIC_API_KEY=
# 선택: OmniRoute 같은 게이트웨이 경유. 설정하면 베타 기능(대체 모델·JSON 스키마 강제) 없이 호출
# ANTHROPIC_BASE_URL=http://localhost:20128
# CLAUDE_MODEL=claude/claude-sonnet-5   # OmniRoute 의 모델 ID (공급자 접두어 포함)

# 1 이면 주문 없이 전 과정을 기록만. 실주문은 0
DRY_RUN=1
# 실행 시각 (KST, 콤마 구분): 개장 22:30 → 23:30 → 00:00 부터 2시간 간격. 정규장 밖 시각은 자동 건너뜀
TRADE_TIMES=22:30,23:30,00:00,02:00,04:00

# --- 깔때기 · 리스크 규칙 (1998~2026 백테스트 기준. 근거는 backtest_slots.py) ---
SCREEN_N=40           # 상위 몇 종목을 Claude 후보 선별에 보여줄지
TOP_N=10              # Claude 가 고르는 후보 수
MAX_POSITIONS=10      # 동시 보유 최대 종목 수
                      #   5 → 10 으로 늘리면 최대낙폭이 양 구간 모두 개선되고(-67.5%→-61.2%,
                      #   -40.8%→-36.7%) 단일 종목 최대 노출이 38.8%→20.9% 로 준다.
                      #   대가는 검증 구간 CAGR -8.6%p. 수익 우선이면 5 도 방어 가능한 선택이다.
MAX_POSITION_PCT=15   # 종목당 최대 비중 (총자산 대비 %). 슬롯 10 에 맞춰 30 → 15
                      #   매수 시점에만 걸린다. 이미 한도를 넘은 보유분을 강제로 팔지는 않는다
                      #   (비중 트림은 성적에 차이가 없었다 — backtest_slots.py)
CASH_RESERVE_PCT=10   # 항상 남겨둘 현금 비중 (%)
MIN_ORDER_USD=5
WORKERS=3             # 종목별 판단 병렬 수

# --- 국면 인식 · 만기 청산 ---
MAX_HOLD_DAYS=20      # 보유 N 거래일이 지나면 코드가 강제 청산. 0 이면 끔
                      #   고정 20거래일 청산의 승률은 56.4% 로, 구 규칙("20일 수익률 음전 시
                      #   매도", 42.1%)보다 14%p 높고 하락 5구간 전부에서 1등이었다
BEAR_INDEX=QQQ        # 국면 판정용 지수 ETF. 빈 값이면 유니버스 60일 수익률 중앙값으로 대체
VOL_TARGET_PCT=30     # 계좌 실현 변동성(연율 %)이 이 값을 넘으면 주식 노출을 줄인다. 0 이면 끔
                      #   타겟 25~35% 가 양 구간 모두 Sharpe·최대낙폭 개선 (타겟 30%:
                      #   Sharpe 1.45→1.48 / 1.32→1.34, MDD -48.2%→-45.1% / -36.9%→-31.2%)
                      #   신규 매수만 조이는 방식은 효과가 0 이었다 — 보유분을 줄여야 작동한다
VOL_WINDOW=60         # 실현 변동성 계산 창 (거래일). 40~120 모두 비슷하게 작동
                      #   ※ 이 창만큼 일별 자산 이력이 쌓여야 기능이 켜진다 (그전엔 자동 비활성)
BEAR_RET60_PCT=-3     # 지수 60일 수익률이 이 값 밑이면 하락 국면 →
                      #   선별 기준이 20일 모멘텀에서 저변동성(atr_pct)으로 바뀐다.
                      #   하락장 진입 승률 50.2%→58.4%(탐색) / 61.6%→68.8%(검증)

# 선택: 뉴스 수집 (serpapi.com). 없으면 뉴스 없이 판단
SERPAPI_API_KEY=
